{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageId = "share-your-result" %}

{% set html %}
<h3
  class="govuk-heading-l govuk-notification-banner__heading "
  style="text-align: center; font-size: 2.25rem; max-width: 100%;">8wDsxn72</h3>
<div style="width: 100%; max-width: 100%;">
  <button
    class="govuk-button govuk-button--secondary"
    data-module="govuk-button"
    style="display: block; margin: 0 auto;"
    onclick="(navigator.clipboard.writeText('8wDsxn72'))">
    {{cms.boxButton}}
  </button>
</div>

{% endset %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">{{cms.title}}</h1>

      {{ govukNotificationBanner({
  html: html,
  titleText: cms.boxHeading
}) }}
      <br>

        <p>{{cms.p1}}</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>{{cms.bullet1}}</li>
          <li>{{cms.bullet2}}</li>
          <li>{{cms.bullet3}}</li>
        </ul>

        <h3 class="govuk-heading-m">{{cms.h1}}</h3>
        <p>{{cms.p2}}</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>{{cms.bullet4}}</li>
          <li>{{cms.bullet5}}</li>
        </ul>

        <p>{{cms.p6}}<a href="/RB_cert_email">{{cms.linkText}}</a>{{cms.p7}}</p>

        {{ govukInsetText({
                    text: cms.insetText
                  }) }}

        {{ govukButton({
                  text: cms.buttonText,
                  href: cms.buttonLink
                  }) }}
      </div>
    </div>

  {% endblock %}

  {% block footer %}
    {% include "footer.njk" %}
  {% endblock %}
