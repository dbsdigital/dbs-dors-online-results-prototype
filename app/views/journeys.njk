{% extends "layouts/layout_standard.njk" %}
{% set serviceName = "DORS Prototype Journeys" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block pageTitle %}
  Select version
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-three-thirds">
      <p class="govuk-body">Select the DORS journey you would like to begin.</p>

      {{ govukTable({
            firstCellIsHeader: false,
            head: [
            {
              text: "Journey"
              },
              {
                text: "Actions"
              },
              {
                text: "Description"
              }
            ],
            rows: [
                  [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Submitted Confirmation Email"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant_submitted_email"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant_submitted_email\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The first email an applicant receives from DORS, confirming their application has been submitted."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Progress Notification Email - 14 Days"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/progress_notification_email-14-days"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/progress_notification_email-14-days\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The email an applicant receives when 14 days have passed but their application is not yet ready to view."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Progress Notification Email - 28 Days"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/progress_notification_email-28-days"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/progress_notification_email-28-days\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The email an applicant receives when 28 days have passed but their application is not yet ready to view."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Application Status Tracker"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/progress_tracker/stage2?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/progress_tracker/stage2\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "Application progress tracker, showing various stages of an application status prior to the result being ready to view. Prototype navigation for this feature in the footer."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result Available Email"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The email an applicant receives when the result is ready to view."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Landing"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/start?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/start\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The first page an applicant lands on in the DORS journey after clicking the link in the applicant email, before GOV UK One Login sign in."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The result page an applicant will see after signing in using Gov UK One Login (1 result)."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result (not clear)"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-nc"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-nc\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The result page an applicant will see after signing in using Gov UK One Login (1 result) and the result is not clear."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result (withdrawn)"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-withdrawn"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-withdrawn\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The result page an applicant will see after signing in using Gov UK One Login (1 result) and the result has been withdrawn."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Share Result Email"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/RB_cert_email"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/RB_cert_email\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The email sent to an applicant when a share code is generated. The applicant will forward this email to a third party (often, a potential employer) to begin the third party journey."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Third Party Landing"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/employer/employer_view_check?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/employer/employer_view_check\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "	The first page a third party lands on in the DORS journey after clicking the link in the applicant share email."
                  }
              ]

              ]


          }) }}
      <h2 class="govuk-heading-s">Archived Journeys.</h2>
      {{ govukTable({
            firstCellIsHeader: false,
            head: [
            {
              text: "Journey"
              },
              {
                text: "Actions"
              },
              {
                text: "Description"
              }
            ],
            rows: [
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result Available Email (title 2)"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant/title"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant/title\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The email an applicant receives when the result is ready to view."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Landing (title 2)"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/start/title"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/start/title\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The first page an applicant lands on in the DORS journey after clicking the link in the applicant email, before GOV UK One Login sign in."
                }
              
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result - Same Table Line"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-same-table-line?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-same-table-line?lang=en\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The same journey as the applicant result except the tables are formatted to have the key and value on the same line."
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result - One Value Per Row"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-one-value-per-row?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-one-value-per-row?lang=en\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The same journey as the applicant result except the tables are formatted to have a single value per row"
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result - Summary List"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-summary-list?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-summary-list?lang=en\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The same journey as the applicant result except the tables are replaced by summary lists"
                  }
              ],
              [
              {
                classes: "govuk-!-width-one-quarter",
                  text: "Applicant Result - Summary List Cards"
              },
              {
                classes: "govuk-!-width-one-quarter",
                html:
                  govukButton({
                    text: "Start",
                    href: "/applicant-result-summary-list-cards?lang=en"
                  }) + "" +
                    "<button class='govuk-button govuk-button--secondary center' onclick='navigator.clipboard.writeText(\"https://dbs-or-alpha.herokuapp.com/applicant-result-summary-list-cards?lang=en\")'>
                        Copy Link
                      </button>"
                },
                {
                  classes: "govuk-!-width-one-half",
                    text: "The same journey as the applicant result except the tables are replaced by summary lists and grouped within cards"
                  }
              ]
              ]


      }) }}

    </div>
  </div>

{% endblock %}