{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageId = "contact-dbs" %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">{{cms.title}}</h1>
      <h2 class="govuk-heading-m">{{cms.h1}}</h2>
      <p>{{cms.p1}}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{cms.bullet1}}</li>
        <li>{{cms.bullet2}}</li>
        <li>{{cms.bullet3}}</li>
      </ul>
      <p>
        {{cms.p2}}
        <a href="https://www.gov.uk/government/publications/dbs-certificate-disputes-and-fingerprint-consent-forms-and-guidance-af14-af15/dbs-certificate-disputes-and-fingerprint-consent-guidance" target="_blank">
        {{cms.linkText1}}
        </a>
        {{cms.p3}}
      </p>

      <h3 class="govuk-heading-m">{{cms.h2}}</h3>
      <p>
        <a href="mailto:RaiseDispute@dbs.gov.uk">{{cms.linkText2}}</a>
      </p>

      <h3 class="govuk-heading-m">{{cms.h3}}</h3>
      <p class="govuk-body">{{cms.p4}}</p>
      <p>{{cms.p5}}</p>
      <p>
        {{cms.p6}}
        <a href="https://www.gov.uk/call-charges" target="_blank">{{cms.linkText3}}</a>
        {{cms.p7}}
      </p>

      <h3 class="govuk-heading-m">{{cms.h4}}</h3>
      <p>
        {{cms.address1}}
        <br>
          {{cms.address2}}
          <br>
            {{cms.address3}}
            <br>
              {{cms.address4}}
              <br>
                {{cms.address5}}
              </p>

              {{ govukInsetText({
  text: cms.insetText
}) }}

              <h2 class="govuk-heading-m">{{cms.h5}}</h2>

              <p>{{cms.p8}}</p>

              <h3 class="govuk-heading-m">{{cms.h6}}</h3>
              <p>
                <a href="mailto:customerservices@dbs.gov.uk">{{cms.linkText4}}</a>
              </p>
              <p>{{cms.p9}}</p>
              <ul class="govuk-list govuk-list--bullet">
                <li>{{cms.bullet4}}</li>
                <li>{{cms.bullet5}}</li>
                <li>{{cms.bullet6}}</li>
                <li>{{cms.bullet7}}</li>
              </ul>

              <h3 class="govuk-heading-m">{{cms.h7}}</h3>
              <ul class="govuk-list govuk-list--bullet">
                <li>{{cms.bullet8}}</li>
                <li>{{cms.bullet9}}</li>
                <li>{{cms.bullet10}}</li>
                <li>{{cms.bullet11A}}<a href="#">{{cms.bullet11B}}</a>{{cms.bullet11C}}</li>
                <li>{{cms.bullet12}}</li>
              </ul>
              <p>{{cms.p10}}</p>
              <p>
                <a href="https://www.gov.uk/call-charges" target="_blank">{{cms.linkText5}}</a>
              </p>

              <h3 class="govuk-heading-m">{{cms.h8}}</h3>
              <p>
                {{cms.address1}}
                <br>
                  {{cms.address2}}
                  <br>
                    {{cms.address3}}
                    <br>
                      {{cms.address4}}
                      <br>
                        {{cms.address5}}
                      </p>

                    </div>
                  </div>
                {% endblock %}
                {% block footer %}
                  {% include "footer.njk" %}
                {% endblock %}
