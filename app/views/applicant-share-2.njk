{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageId = "share-your-result" %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

    {{ govukBackLink({
    href: cms.backlink,
    text: "Back"
  }) }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">

      <div id="share-result">
        <h1 class="govuk-heading-l">{{cms.title}}</h1>
        <p>{{cms.p1}}</p>
        <div class="govuk-form-group">
          <div class="govuk-grid-column-two-thirds" style="padding: 0;">
            <label class="govuk-label govuk-label--m" for="event-name">
              {{cms.textInputLabel}}
            </label>

            <input class="govuk-input" id="event-name" name="event-name" type="text"></div>
          </div>

          {{ govukButton({
            text: cms.buttonText,
            href: cms.buttonLink,
            classes: "govuk-!-margin-bottom-0"
          }) }}

        </div>
      </div>
    </div>

  {% endblock %}

  {% block footer %}
    {% include "footer.njk" %}
  {% endblock %}
