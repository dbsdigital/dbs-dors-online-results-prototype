{% extends "layouts/layout_onelogin.njk" %}

{% set pageId = "manage-share-codes" %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-width-container">

      <h2 class="govuk-heading-l">{{cms.title}}</h2>
      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{cms.tableHeading1}}
            </th>
            <th scope="col" class="govuk-table__header">{{cms.tableHeading2}}</th>
            <th scope="col" class="govuk-table__header">{{cms.tableHeading3}}</th>
            <th scope="col" class="govuk-table__header">{{cms.tableHeading4}}</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">NHS</td>
            <td class="govuk-table__cell">8wDsxn72</td>
            <td class="govuk-table__cell">Active</td>
            <td class="govuk-table__cell">
              <a href="#">{{cms.tableCancelLink}}</a>
            </td>
          </tr>

          <tr class="govuk-table__row">
            <td class="govuk-table__cell">DfE</td>
            <td class="govuk-table__cell">O8o9j846</td>
            <td class="govuk-table__cell">Used</td>
            <td class="govuk-table__cell"></td>
          </tr>

          <tr class="govuk-table__row">
            <td class="govuk-table__cell">DWP</td>
            <td class="govuk-table__cell">1u8t7F8T</td>
            <td class="govuk-table__cell">Cancelled</td>
            <td class="govuk-table__cell"></td>
          </tr>

          <tr class="govuk-table__row">
            <td class="govuk-table__cell">NHS</td>
            <td class="govuk-table__cell">g8H3a7wE</td>
            <td class="govuk-table__cell">Expired</td>
            <td class="govuk-table__cell"></td>
          </tr>
        </tbody>
      </table>

    </div>
  </div>
{% endblock %}
{% block footer %}
  {% include "footer.njk" %}
{% endblock %}
