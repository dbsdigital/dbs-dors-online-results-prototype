{% extends "layouts/layout_progress_tracker.njk" %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "hmrc/components/language-select/macro.njk" import hmrcLanguageSelect %}

{% block pageTitle %}
  Your DBS check is complete – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}

  <div class="govuk-grid-row">

    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">{{cms.title}}</h1>
      <p>{{cms.p1}}</p>
      <p>
        <a href="/start-nc">{{cms.linkText}}
        </a>
        {{cms.p2}}
      </p>
      <br/> <br/>

      {{ govukTaskList({
  idPrefix: "company-details",
  items: [
    {
      title: {
        text: cms.stage1Title,
        classes: "govuk-heading-s"
      },
      hint: {
        text: cms.stage1Description
      },
      status: {
        classes: "vertical-align-bottom",
        text: cms.stage1Value + formattedDateSevenDaysAgo
      }
    },
    {
      title: {
        text: cms.stage2Title,
        classes: "govuk-heading-s"
      },
      hint: {
        text: cms.stage2Description
      },
      status: {
        classes: "vertical-align-bottom",
        text: cms.stage2Value + formattedDateSixDaysAgo
      }
    },
    {
      title: {
        text: cms.stage3Title,
        classes: "govuk-heading-s"
      },
      hint: {
        text: cms.stage3Description
      },
      status: {
        classes: "vertical-align-bottom",
        text: cms.stage3Value + formattedDateSixDaysAgo
      }
    },
    {
      title: {
        text: cms.stage4Title,
        classes: "govuk-heading-s"
      },
      hint: {
        text: cms.stage4Description
      },
      status: {
        classes: "vertical-align-bottom",
        text: cms.stage4Value + formattedDateFiveDaysAgo
      }
    },
    {
      title: {
        text: cms.stage5Title,
        classes: "govuk-heading-s"
      },
      hint: {
        text: cms.stage5Description
      },
      status: {
        classes: "vertical-align-bottom",
        text: cms.stage5Value + formattedDateTwoDaysAgo
      }
    }
  ]
}) }}

    </div>
  </div>

{% endblock %}
