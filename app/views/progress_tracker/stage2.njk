{% extends "layouts/layout_progress_tracker.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "hmrc/components/language-select/macro.njk" import hmrcLanguageSelect %}

{% block pageTitle %}
  Track the progress of your DBS check – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}

  <div class="govuk-grid-row">

    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">{{cms.title}}</h1>
      <p>{{cms.p1}}</p>
      <p>{{cms.p2}}{{ currentDate }}</p>

      {{ govukInsetText({
        text: cms.insetText
      }) }}

      {{ govukTaskList({
  idPrefix: "company-details",
  items: [
    {
      classes: "no-border-top",
      title: {
        text: cms.stage1Title,
        classes: "govuk-heading-m no-border-top"
      },
      hint: {
        text: cms.stage1Description
      },
      status: {
        text: cms.stage1Value + formattedDateOneWeekAgo,
        classes: "vertical-align-bottom"
      }
    },
    {
      title: {
        text: cms.stage2Title,
        classes: "govuk-heading-m"
      },
      hint: {
        text: cms.stage2Description
      },
      status: {
        classes: "vertical-align-bottom",
        tag: {
          text: cms.stage2Value,
          classes: "govuk-tag--light-blue vertical-align-bottom"
        }
      }
    },
    {
      title: {
        text: cms.stage3Title,
        classes: "govuk-heading-m"
      },
      hint: {
        text: cms.stage3Description
      },
      status: {
        classes: "vertical-align-bottom",
        tag: {
          text: cms.stage3Value,
          classes: "govuk-tag--blue"
        }
      }
    },
    {
      title: {
        text: cms.stage4Title,
        classes: "govuk-heading-m"
      },
      hint: {
        text: cms.stage4Description
      },
      status: {
        classes: "vertical-align-bottom",
        tag: {
          text: cms.stage4Value,
          classes: "govuk-tag--blue"
        }
      }
    },
    {
      title: {
        text: cms.stage5Title,
        classes: "govuk-heading-m"
      },
      hint: {
        text: cms.stage5Description
      },
      status: {
        classes: "vertical-align-bottom",
        tag: {
          text: cms.stage5Value,
          classes: "govuk-tag--blue"
        }
      }
    }
  ]
}) }}

    </div>
  </div>

{% endblock %}
