{% extends "layouts/layout_employer.html" %}

{% block pageTitle %}
View someone’s DBS result online – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-three-thirds">

      <h1 class="govuk-heading-xl">
        {{cms.title}}
      </h1>

      <p>{{cms.p1}}</p>

      <h2 class="govuk-heading-m">{{cms.h1}}</h2>
      <p>{{cms.p2}}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{cms.bullet1}}</li>
        <li>{{cms.bullet2}}</li>
      </ul>

      {% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{{ govukInsetText({
  text: cms.insetText
}) }}

<p>{{cms.p3}}</p>

<p>{{cms.p4}}</p>

<h3 class="govuk-heading-s">{{cms.h2}}</h3>
<p class="govuk-body">{{cms.p5}}</p>
<p class="govuk-body">{{cms.p6}}</p>

<ul class="govuk-list govuk-list--bullet">
  <li>{{cms.bullet3}}</li>
  <li>{{cms.bullet4}}</li>
  <li>{{cms.bullet5}}</li>
  <li>{{cms.bullet6}}</li>
  <li>{{cms.bullet7}}</li>
  <li>{{cms.bullet8}}</li>
</ul>

<p class="govuk-body">{{cms.p7}}</p>


{% from "govuk/components/button/macro.njk" import govukButton %}

{{ govukButton({
  text: cms.buttonText,
  isStartButton: true,
  href: cms.buttonLink
}) }}
      
      </div>
{% endblock %}
