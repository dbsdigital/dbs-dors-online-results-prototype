
{% extends "govuk/template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block pageTitle %}
  PDF Preview – GOV.UK Prototype Kit
{% endblock %}

{% block head %}
  {% include "includes/head.njk" %}
{% endblock %}

{% block header %}{% endblock %}

{% block footer %}{% endblock %}

{% block bodyEnd %}
  {% include "includes/scripts.njk" %}
{% endblock %}


{% block content %}
<div class="govuk-grid-row">

    {{ govukWarningText({
      text: "This page will be a downloadable PDF file within the real service",
      iconFallbackText: "Warning"
    }) }}
    <img src="/public/images/Disclosure_and_Barring_Service_Logo.svg" class="dbs-logo" style="margin-bottom: 40px;">

    <h1 class="govuk-heading-l">DBS check result receipt</h1>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Applicant name</h3>
    <p class="govuk-body">Bill Carr</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Date result was viewed</h3>
    <p class="govuk-body">12 December 2022</p>

    <h2 class="govuk-heading-m">DBS check details</h2>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Certificate number</h3>
    <p class="govuk-body">001034176560</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Certificate date of issue</h3>
    <p class="govuk-body">8 December 2022</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Check level</h3>
    <p class="govuk-body">Enhanced</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Barred lists checked</h3>
    <p class="govuk-body">Adults' and Children's</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Workforce type</h3>
    <p class="govuk-body">Adult and Children</p>

    <h3 class="govuk-heading-s" style="margin-bottom: 6px;">Post applied for</h3>
    <p class="govuk-body">Traffic Flow Administrator</p>


    <hr style="margin-top: 48px">
    <p class="govuk-body">Page 1 of 1</p>
    </div>

{% endblock %}