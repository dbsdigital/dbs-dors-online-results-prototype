{% extends "layouts/layout_employer.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block pageTitle %}
  View results complete – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

      {{ govukPanel({
        titleText: cms.boxTitle,
        html: cms.boxText + "<br><strong>XXXXXX176560</strong>"
      }) }}
      <p>
        {{cms.p1}}
      </p>
      <p>{{cms.p2}}</p>

      <p class="govuk-body">
        <a href="/employer/receipt-pdf" class="govuk-link" target="_blank">
          {{cms.linkText1}}
        </a>
      </p>

      <h2 class="govuk-heading-m">{{cms.h1}}</h2>
      <p>
        {{cms.p3}}
        <a class="govuk-link" href="https://give-feedback-dbs.service.gov.uk/#/en/e-result" target="_blank">
          {{cms.linkText2}}
        </a>
        {{cms.p4}}
      </p>

      {% from "govuk/components/button/macro.njk" import govukButton %}

      {{ govukButton({
        text: cms.buttonText,
        href: cms.buttonLink
      }) }}
    </div>
  </div>
{% endblock %}
