{% extends "layouts/layout_employer.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block pageTitle %}
  View results complete – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: "beta"
    },
    html: 'This is a new service. Help us improve it and <a class="govuk-link" target="_blank" href="#">give your feedback (opens in a new tab).</a>'
  }) }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

      {{ govukPanel({
        titleText: "DBS online result viewed",
        html: "Certificate reference number<br><strong>XXXXXX176560</strong>"
      }) }}
      <p>
        We have told the applicant you have viewed their result.
      </p>
      <p>If you need to view the result again you will need a new share code from the applicant.</p>

      <p class="govuk-body">
        <a href="/public/pdfs/176560-result-receipt.pdf" download="176560-result-receipt.pdf">Download a PDF receipt as proof
          you have viewed this Online Result (opens in a new tab)</a>
      </p>

      <h2 class="govuk-heading-m">Give feedback</h2>
      <p>
        Please
        <a class="govuk-link" href="https://give-feedback-dbs.service.gov.uk/#/en/e-result" target="_blank">use our feedback
          form</a>
        to tell us what you think of our service.
      </p>

      {% from "govuk/components/button/macro.njk" import govukButton %}

      {{ govukButton({
        text: "Finish",
        href: "/employer/employer_view_check"
      }) }}
    </div>
  </div>
{% endblock %}
