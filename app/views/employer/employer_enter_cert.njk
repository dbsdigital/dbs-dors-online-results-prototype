{% import "macros/error-summary/govukErrorSummary.njk" as  es %}
{% extends "layouts/layout_employer.njk" %}
{% block pageTitle %}
  DBS Online Result Service – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{cms.title}}</h1>

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            {{cms.h1}}
          </legend>
          <p style="color: #4E4E4E">
            {{cms.label1}}
          </p>
          <div class="govuk-form-group">
            <input class="govuk-input govuk-input--width-20" id="dbs-certificate-nr" name="dbs-certificate-nr" type="text"/>
          </div>
        </fieldset>
        <br>
          <br>
            <br>
              <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                  {{cms.h2}}
                </legend>
                <p style="color: #4E4E4E">
                  {{cms.label2}}
                </p>
                <div class="govuk-form-group">
                  <input class="govuk-input govuk-input--width-20" id="dbs_share_code" name="dbs-certificate-nr" type="text"/>
                </div>
              </fieldset>
            </div>
            {% from "govuk/components/button/macro.njk" import govukButton %}

            {{ govukButton({
  text: cms.buttonText,
  href: cms.buttonLink
}) }}

          </div>
        </div>
      {% endblock %}
