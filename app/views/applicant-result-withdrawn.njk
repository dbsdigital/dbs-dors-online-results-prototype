{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageId = "view-your-result" %}

<!-- Override default header with gov uk one login header -->
{% block header %}
  {% set navItems = [{
      }] %}

  {{ govukOneLoginServiceHeader({
    rebrand: true,
    serviceNavigationParams:
    {
      serviceName: "View or share your DBS result",
      navigation: navItems
    },
    signOutLink: "/sign-out",
    signOutText: "Sign out",
    oneLoginLink: "#"
  }) }}
{% endblock %}

{% block pageTitle %}
  Your DBS check application was withdrawn – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{cms.title}}</h1>
      <p>{{cms.p1}}</p>

      <p>{{cms.p2}}</p>

      <p>{{cms.p3}}</p>

      {{ govukButton({
        text: cms.buttonText,
        href: cms.buttonLink
      }) }}
    </div>

  </div>
</div>{% endblock %}{% block footer %}
{% include "footer.njk" %}{% endblock %}
