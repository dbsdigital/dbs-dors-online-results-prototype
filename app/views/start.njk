{% extends "layouts/layout_standard.njk" %}
{% from "hmrc/components/language-select/macro.njk" import hmrcLanguageSelect %}

{% block pageTitle %}
  View your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: "beta"
    },
    html: "Mae hwn yn wasanaeth newydd. Helpwch ni i'w wella a<a class='govuk-link' target='_blank' href='#''>
      rhoi eich adborth (yn agor mewn tab newydd).</a>" if data['lang'] == "cy" else
      'This is a new service. Help us improve it and <a class="govuk-link" target="_blank" href="#">
      give your feedback (opens in a new tab).</a>'
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}

  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      {% if title %}
        <h1 class="govuk-heading-xl">
          {{ cms.title }}
        </h1>
      {% else %}
        <h1 class="govuk-heading-xl">
          {{ cms.title }}
        </h1>
      {% endif %}

      <p>{{ cms.p1 }}</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>{{ cms.bullet1 }}</li>
        <li>{{ cms.bullet2 }}</li>
        <li>{{ cms.bullet3 }}</li>
      </ul>

      <h2 class="govuk-heading-m">{{ cms.h1 }}</h2>
      <p>{{ cms.p2 }}</p>
      <p>{{ cms.p3 }}</p>

      {% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

      {{ govukInsetText({
        text: cms.insetText
      }) }}

      <h2 class="govuk-heading-m">{{ cms.h2 }}</h2>
      <p>{{ cms.p4 }}</p>

      {% from "govuk/components/button/macro.njk" import govukButton %}

      {{ govukButton({
          text: "Dechrau" if data['lang'] == "cy" else "Start",
          isStartButton: true,
          classes: 'govuk-!-margin-top-2 govuk-!-margin-bottom-8',
          href: "/create_account"
        }) }}

    </div>

  </div>

{% endblock %}

{% block footer %}
  {% include "footer.njk" %}
{% endblock %}