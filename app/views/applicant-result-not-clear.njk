{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageId = "view-your-result" %}

<!-- Override default header with gov uk one login header -->
{% block header %}
  {% set navItems = [{
      }] %}

  {{ govukOneLoginServiceHeader({
    rebrand: true,
    serviceNavigationParams:
    {
      serviceName: "View or share your DBS result",
      navigation: navItems
    },
    signOutLink: "/sign-out",
    signOutText: "Sign out",
    oneLoginLink: "#"
  }) }}
{% endblock %}

{% block pageTitle %}
  We have sent your DBS result in the post – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: "beta"
    },
    html: 'This is a new service. Help us improve it and <a class="govuk-link" target="_blank" href="#">give your feedback (opens in a new tab).</a>'
  }) }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">We have sent your DBS result in the post</h1>
      <p>
        It will be delivered to the address you gave us in your application. 
        It should arrive within 7 working days. You can share this printed result with someone else, 
        like your employer.
      </p>

      <p>We cannot display the result of your DBS check online.</p>

      {{ govukButton({
        text: "Finish",
        href: "/start"
      }) }}
    </div>

  </div>
</div>{% endblock %}{% block footer %}
{% include "footer.njk" %}{% endblock %}
