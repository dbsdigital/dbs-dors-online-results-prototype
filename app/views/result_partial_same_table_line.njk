{% from "govuk/components/table/macro.njk" import govukTable %}
<img src="/public/images/Disclosure_and_Barring_Service_Logo.svg" class="dbs-logo">

<div
  class="govuk-notification-banner govuk-notification-banner--success"
  role="region"
  aria-labelledby="govuk-notification-banner-title"
  data-module="govuk-notification-banner">
  <div class="govuk-notification-banner__header">
    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
      DBS Check Result
    </h2>
  </div>

  <div class="govuk-notification-banner__content">
    <p class="govuk-notification-banner__heading" id="banner-content">
      This Enhanced DBS Check is clear
    </p>
    <p>This Enhanced DBS Check was issued on
      <strong>08/12/2022.</strong>
    </p>
    <p>
      <strong>It is only valid when viewed online. It is not valid if printed.</strong>
    </p>
  </div>
</div>

{{ govukTable({
  captionClasses: "govuk-table__caption--m",
  firstCellIsHeader: true,
