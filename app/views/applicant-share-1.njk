{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageId = "share-your-result" %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: "beta"
    },
    html: 'This is a new service. Help us improve it and <a class="govuk-link" target="_blank" href="#">give your feedback (opens in a new tab).</a>'
  }) }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-width-container">

      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">How to share your DBS result</h1>
        <p>You can use this part of the service to share your result with someone else, like your employer.</p>

        <h2 class="govuk-heading-m">How this works</h2>
        <p>
          You will need to tell us who you want to share your result with, we will then generate a one time
          share code to allow them to view your result.
        </p>

        <p>We will also send you an email with:</p>

        <ul class="govuk-list govuk-list--bullet">
          <li>instructions on how to share your result</li>
          <li>the last 6 digits of your certificate number</li>
          <li>a link to access your result</li>
        </ul>

        {{ govukInsetText({
          text: "You will need to send the share code and email to the person you want to view your result."
        }) }}

        {{ govukButton({
          isStartButton: true,
          text: "Share Result",
          href: "/applicant-share-2"
        }) }}

        <h3 class="govuk-heading-s">Receipts for Online Results</h3>

        <p class="govuk-body">The person you share your Online Result with can also download a receipt to prove they have viewed
          your result.</p>
        <p class="govuk-body">The receipt includes:</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>your name</li>
          <li>your position - for example, teacher</li>
          <li>your DBS certificate number and date of issue</li>
          <li>if your check is standard or enhanced and the workforce it is for</li>
          <li>if any barred lists were checked</li>
          <li>the date they viewed your online result</li>
        </ul>

      </div>
    </div>
  </div>

{% endblock %}

{% block footer %}
  {% include "footer.njk" %}
{% endblock %}
