{% extends "layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageId = "share-your-result" %}

{% block pageTitle %}
  Your online result – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-width-container">

      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">{{cms.title}}</h1>
        <p>{{cms.p1}}</p>

        <h2 class="govuk-heading-m">{{cms.h1}}</h2>
        <p>{{cms.p2}}</p>
        <p>{{cms.p3}}</p>

        <ul class="govuk-list govuk-list--bullet">
          <li>{{cms.bullet1}}</li>
          <li>{{cms.bullet2}}</li>
          <li>{{cms.bullet3}}</li>
        </ul>

        {{ govukInsetText({
          text: cms.insetText1
        }) }}

        {{ govukButton({
          isStartButton: true,
          text: cms.buttonText,
          href: cms.buttonLink
        }) }}

        <h3 class="govuk-heading-s">{{cms.h2}}</h3>

        <p class="govuk-body">{{cms.p4}}</p>
        <p class="govuk-body">{{cms.p5}}</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>{{cms.bullet4}}</li>
          <li>{{cms.bullet5}}</li>
          <li>{{cms.bullet6}}</li>
          <li>{{cms.bullet7}}</li>
          <li>{{cms.bullet8}}</li>
          <li>{{cms.bullet9}}</li>
        </ul>

      </div>
    </div>
  </div>

{% endblock %}

{% block footer %}
  {% include "footer.njk" %}
{% endblock %}
