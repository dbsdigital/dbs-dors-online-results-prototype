{% extends "layouts/layout_email.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block pageTitle %}
  Email for result not available – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}
{% block content %}

  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <p>Dear Bill Carr,</p>

      <p>Your standard Disclosure and Barring Service (DBS) check is complete.</p>

      {{ govukInsetText({
        html: "<div>Your application reference number is E036125498</div><div>Your certificate number is 001034176560</div>"
      }) }}

      <h2 class="govuk-heading-m">We have sent your DBS result in the post</h2>

      <p>It will be delivered to the address you gave us in your application. It should arrive within 7 working days. You can share this printed result with someone else, like your employer.</p>

      <p>We cannot display the result of this DBS check online.</p>
      
      <h2 class="govuk-heading-m">Contact DBS</h2>

      <ul class="govuk-list govuk-list--bullet">
        <li>DBS Helpline: 03000 200 190</li>
        <li>Welsh language: 03000 200 191</li>
        <li>Relay UK: If you have difficulty with your speech or hearing, dial 18001 then 03000 200 192</li>
        <li>Convo: If you are a British Sign Language (BSL) user, you can
          <a href="#">use Convo to connect to DBS
          </a>via an Interpreter.</li>
        <li>International: +44 (0)151 676 9390</li>
      </ul>
      <p>Monday to Friday, 9am to 5pm (except public holidays)</p>
      <p>
        <a href="#">Find out about call charges</a>
      </p>

      <h2 class="govuk-heading-m">Give feedback</h2>
      <p>Please
        <a href="https://give-feedback-dbs.service.gov.uk/#/en/dors-applicant" target="_blank">use our feedback form</a>
        to tell us what you think of our service.</p>
      
    </div>

  </div>

{% endblock %}
