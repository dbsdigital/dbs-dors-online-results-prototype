{% extends "layouts/layout_disputes.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% block beforeContent %}
  {{ govukBackLink({
    text: commonCms.backlink,
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{cms.h1}}</h1>

      {{ govukInput({
        label: { text: cms.textbox1 },
        id: "text1",
        name: "text1"
      }) }}

      {{ govukInput({
        label: { text: cms.textbox2 },
        id: "text1",
        name: "text1"
      }) }}

      {{ govukInput({
        label: { text: cms.textbox3 },
        id: "text1",
        name: "text1"
      }) }}

      {{ govukDateInput({
        id: "date1",
        namePrefix: "date1",
        fieldset: {
          legend: {
            text: cms.date1.label,
            classes: "govuk-fieldset__legend--m"
          }
        },
        hint: {
          text: cms.date1.hint
        },
        items: [{
          name: "year",
          label: commonCms.year,
          classes: "govuk-date-input__input govuk-input--width-4"
        }]
      }) }}

      
      {% set stopUsingNameHtml %}
      {{ govukDateInput({
        id: "date2",
        namePrefix: "date2",
        fieldset: {
          legend: {
            text: cms.date2.label
          }
        },
        hint: {
          text: cms.date2.hint
        },
        items: [{
          name: "year",
          label: commonCms.year,
          classes: "govuk-date-input__input govuk-input--width-4"
        }]
      }) }}
      {% endset %}

      {{ govukRadios({
        name: "whereDoYouLive",
        fieldset: {
          legend: {
            text: cms.radio1,
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          {
            value: "yes",
            text: commonCms.yes,
            conditional: {
              html: stopUsingNameHtml
            }
          },
          {
            value: "no",
            text: commonCms.no
          }
        ]
      }) }}

      {{ govukButton({
        text: commonCms.continue,
        href: nextPage
      }) }}
    </div>

  </div>
</div>{% endblock %}
