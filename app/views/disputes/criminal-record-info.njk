{% extends "layouts/layout_disputes.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block beforeContent %}
  {{ govukBackLink({
    text: commonCms.backlink,
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{cms.h1}}</h1>
      <p>{{cms.p1}}</p>

      {{ govukInput({
        label: { text: cms.textbox1 },
        id: "text1",
        name: "text1"
      }) }}

      {{ govukInput({
        label: { text: cms.date1 },
        id: "date1",
        name: "date1",
        classes: "govuk-date-input__input govuk-input--width-4"
      }) }}

      {{ govukInput({
        label: { text: cms.textbox2 },
        id: "text2",
        name: "text2"
      }) }}

      {{ govukDateInput({
        id: "date2",
        namePrefix: "date2",
        fieldset: {
          legend: {
            text: cms.date2
          }
        }
      }) }}

      {{ govukButton({
        text: commonCms.continue,
        href: nextPage
      }) }}
    </div>

  </div>
</div>{% endblock %}
