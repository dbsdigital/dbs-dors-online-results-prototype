{% extends "layouts/layout_disputes.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block beforeContent %}
  {{ govukBackLink({
    text: commonCms.backlink,
    href: backLink
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{cms.h1}}</h1>

      {{ govukInput({
        label: { text: cms.textbox1 },
        id: "text1",
        name: "text1"
      }) }}

      {{ govukInput({
        label: { text: cms.textbox2 },
        id: "text2",
        name: "text2"
      }) }}

      {{ govukInput({
        label: { text: cms.textbox3 },
        id: "text3",
        name: "text3"
      }) }}

      {{ govukButton({
        text: commonCms.continue,
        href: nextPage
      }) }}
    </div>

  </div>
</div>{% endblock %}
