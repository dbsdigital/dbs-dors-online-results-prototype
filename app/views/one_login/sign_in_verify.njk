{% extends "../layouts/layout_onelogin.njk" %}

{% block pageTitle %}
  Sign in to your GOV.UK account – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  <!-- Blank header with no service name for the start page -->
  {{ govukHeader() }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

  <a href="/create_account" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <form>
        <h1 class="govuk-label-wrapper">
          <label class="govuk-label govuk-label--l">
            {{cms.title}}
          </label>
        </h1>

        <div class="govuk-form-group">

          <label class="govuk-label" for="password">
            {{cms.label}}
          </label>

          <input class="govuk-input" id="password" name="password" type="password" spellcheck="false" autocomplete="false"></div>

          <a href="/sign_in_otp" role="button" class="govuk-button">
            {{cms.button1}}
          </a>

        </form>

      </div>

    </div>

  {% endblock %}
