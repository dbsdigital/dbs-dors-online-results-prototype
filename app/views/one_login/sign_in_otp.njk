{% extends "../layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  Enter your 6 digit security code – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}

{% block header %}
  <!-- Blank header with no service name for the start page -->
  {{ govukHeader() }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

  <a href="/create_account" class="govuk-back-link">Back</a>

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l govuk-!-margin-top-0 govuk-!-margin-bottom-3">
        {{cms.title}}
      </h1>

      <p class="govuk-body">{{cms.p1}}</p>
      <p class="govuk-body">{{cms.p2}}</p>

      <div class="govuk-form-group">
        <label class="govuk-label" for="mobOTP">
          {{cms.p3}}
        </label>
        <input
          class="govuk-input govuk-input--width-10"
          id="mobOTP"
          name="mobOTP"
          value=""
          spellcheck="false"
          inputmode="text"/>
      </div>

      <br>
        <details class="govuk-details" data-module="govuk-details">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">
              {{cms.dropDownText}}
            </span>
          </summary>
          <div class="govuk-details__text">
            {{cms.insetText1}}
            <a href="#">{{cms.insetText2}}</a>
            {{cms.insetText3}}
          </div>
        </details>

        {{ govukButton({
          text: cms.button1,
          href: "/applicant-result?lang=cy" if lang === "cy" else "/applicant-result?lang=en"
        }) }}

      </div>

    </div>
  {% endblock %}
