{% extends "../layouts/layout_onelogin.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  Create an account or sign in – {{ serviceName }} – GOV.UK Prototype Kit
{% endblock %}
{% block header %}
  <!-- Blank header with no service name for the start page -->
  {{ govukHeader() }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: {
      text: commonCms.headerText.bannerPhase
    },
    html: commonCms.headerText.bannerText
  }) }}

  {{
    hmrcLanguageSelect({
    language: 'cy' if data['lang'] === 'cy' else 'en',
    en: { href: '?lang=en' },
    cy: { href: '?lang=cy' }
    })
  }}

{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l govuk-!-margin-top-0 govuk-!-margin-bottom-3">
        {{cms.title}}
      </h1>

      <p>{{cms.p1}}</p>
      <p>{{cms.p2}}</p>
      <p>{{cms.p3}}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{cms.bullet1}}</li>
        <li>{{cms.bullet2}}</li>
      </ul>

      {% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

      {{ govukInsetText({
        html: "<p>" + cms.insetText1 + "<a href='' classes='govuk-link'>" + cms.insetText2 + "</a></p>"
      }) }}

      {{ govukButton({
        text: cms.button1,
        href: "#",
        isStartButton: false,
        classes: "govuk-!-margin-right-3"
      }) }}

      <div class="one-login-sign-in-div">
      {{ govukButton({
        text: cms.button2,
        href: "/sign_in",
        classes: "govuk-button--secondary"
      }) }}
      </div>

      <p><a href="https://www.gov.uk/using-your-gov-uk-one-login/services">{{cms.linkText1}}</a></p>
    </div>

  </div>
{% endblock %}
