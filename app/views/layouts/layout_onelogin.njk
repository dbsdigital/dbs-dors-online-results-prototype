{% extends "govuk-prototype-kit/layouts/unbranded.njk" %}
{% from "one_login/header/service-header.njk" import govukOneLoginServiceHeader %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}
{% block head %}
  {% include "includes/head.njk" %}

{% endblock %}

<!-- Override default header with gov uk one login header -->
{% block header %}
  {% set navItems = [{
      active: true if pageId == 'view-your-result',
      href: commonCms.navBar.tab1Link,
      text: commonCms.navBar.tab1
    },{
      active: true if pageId == 'share-your-result',
      href: commonCms.navBar.tab2Link,
      text: commonCms.navBar.tab2
    },{
      active: true if pageId == 'manage-share-codes',
      href: commonCms.navBar.tab3Link,
      text: commonCms.navBar.tab3
    },
    {
      active: true if pageId == 'contact-dbs',
      href: commonCms.navBar.tab4Link,
      text: commonCms.navBar.tab4
    }] %}

  {{ govukOneLoginServiceHeader({
    rebrand: true,
    serviceNavigationParams:
    {
      serviceName: commonCms.navBar.serviceText,
      navigation: navItems
    },
    signOutLink: "/sign-out",
    signOutText: commonCms.navBar.signOut,
    oneLoginLink: "#"
  }) }}
{% endblock %}

{% block footer %}
  {{ govukFooter({}) }}
{% endblock %}
